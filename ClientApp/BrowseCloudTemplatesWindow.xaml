<Window x:Class="ClientApp.BrowseCloudTemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse Cloud Templates" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Side: Template Grid -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Modern Gradient Header -->
            <Border Grid.Row="0" Margin="24,24,24,8">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Cloud Template Library" Style="{DynamicResource HeadlineLg}" FontWeight="Black" FontSize="32">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource TertiaryColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click" Padding="16,8" Style="{DynamicResource TertiaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="Refresh Library" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="Discover professional layouts shared by the community." Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="14" Margin="0,4,0,16"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0">
                <WrapPanel x:Name="CloudTemplatesList"/>
            </ScrollViewer>
            
            <!-- Loading Overlay -->
            <Grid x:Name="LoadingOverlay" Grid.Row="2" Visibility="Collapsed">
                <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.7"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Fetching Templates..." HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
        
        <!-- Right Side: Details & Preview -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceContainerLowBrush}" Padding="32" CornerRadius="32,0,0,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Live Preview" Style="{DynamicResource HeadlineMd}" Margin="0,0,0,20" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"/>
                        
                        <Border Height="450" Background="White" CornerRadius="16" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="5"/>
                            </Border.Effect>
                            <Viewbox Stretch="Uniform" Margin="10">
                                <ContentControl x:Name="PreviewContent"/>
                            </Viewbox>
                        </Border>
                        
                        <TextBlock x:Name="txtTemplateName" Text="Select a template" FontWeight="Black" FontSize="24" Margin="0,24,0,4" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock x:Name="txtTemplateAuthor" Text="By Joborgan Labs" Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="14" Margin="0,0,0,24"/>
                        
                        <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DESCRIPTION" FontWeight="Black" FontSize="11" Opacity="0.6" Margin="0,0,0,12" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                <TextBlock x:Name="txtDescription" Text="Select a template from the library to see its details and preview how it will look with your company data." 
                                           TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceBrush}" FontSize="14" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                
                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                    <Button x:Name="btnDownload" Content="💾 Download &amp; Save" Style="{DynamicResource PrimaryButtonStyle}" Height="50" FontSize="15" FontWeight="Bold" Click="Download_Click" IsEnabled="False" Margin="0,0,0,10"/>
                    <Button x:Name="btnCustomize" Content="🎨 Customize in Designer" Style="{DynamicResource SecondaryButtonStyle}" Height="50" FontSize="15" FontWeight="Bold" Click="Customize_Click" IsEnabled="False" Margin="0,0,0,10"/>
                    <Button Style="{DynamicResource TertiaryButtonStyle}" Height="40" Click="Close_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11"/>
                            <TextBlock Text="Dismiss" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
