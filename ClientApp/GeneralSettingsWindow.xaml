<Window x:Class="ClientApp.GeneralSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="680" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource SurfaceContainerLowestBrush}" 
            CornerRadius="24" 
            BorderThickness="1" 
            BorderBrush="{DynamicResource SurfaceContainerBrush}"
            MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="32,32,32,0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource HeadlineMd}" Text="System Settings" Margin="0,0,0,8"/>
                    <TextBlock Text="Personalize your workspace experience." Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,0"/>
                </StackPanel>
                
                <Button Style="{DynamicResource SecondaryButtonStyle}" 
                        Content="✕" 
                        Width="32" Height="32" 
                        Padding="0"
                        FontSize="16"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Click="Save_Click"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Margin="8,16,8,32" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,0">
                    <TextBlock Text="APPEARANCE" Style="{DynamicResource BodyMd}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Margin="0,16,0,16" Opacity="0.8"/>
                    
                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,24">
                        <DockPanel LastChildFill="False">
                            <StackPanel>
                                <TextBlock Text="Dark Appearance" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="Saves battery and reduces eye strain." Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="12"/>
                            </StackPanel>
                            <CheckBox x:Name="chkDarkMode" Style="{DynamicResource ToggleSwitchStyle}" DockPanel.Dock="Right" Click="DarkMode_Click" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="CLOUD &amp; MULTI-DEVICE SYNCHRONIZATION" Style="{DynamicResource BodyMd}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Margin="0,0,0,16" Opacity="0.8"/>
                    
                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Cloud Sync &amp; Account Settings" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                            <TextBlock Text="Configure cloud activation key, storage usage, and image upload preferences." Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <Button Content="Configure Cloud Key &amp; Preferences" Style="{DynamicResource AccentedButtonStyle}" Click="OpenCloudSettings_Click" HorizontalAlignment="Stretch" Padding="12,10" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="BACKUP &amp; SAFETY" Style="{DynamicResource BodyMd}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Margin="0,0,0,16" Opacity="0.8"/>
                    
                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Automatic Backups" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="Regularly saves offline database backups." Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="12"/>
                                </StackPanel>
                                <CheckBox x:Name="chkAutoBackup" Style="{DynamicResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Backup Interval" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="How often backups are auto-saved." Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="12"/>
                                </StackPanel>
                                <ComboBox x:Name="cmbBackupInterval" Width="130" Height="36" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="8,4"
                                          Background="{DynamicResource SurfaceContainerLowestBrush}" Foreground="{DynamicResource OnSurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}">
                                    <ComboBoxItem Content="1 Minute" Tag="1"/>
                                    <ComboBoxItem Content="5 Minutes" Tag="5"/>
                                    <ComboBoxItem Content="10 Minutes" Tag="10"/>
                                    <ComboBoxItem Content="30 Minutes" Tag="30"/>
                                    <ComboBoxItem Content="60 Minutes" Tag="60"/>
                                </ComboBox>
                            </DockPanel>

                            <Separator Background="{DynamicResource OutlineBrush}" Margin="0,16,0,16" Opacity="0.3"/>

                            <UniformGrid Columns="2">
                                <Button Content="Export Active Orders" Style="{DynamicResource SecondaryButtonStyle}" Click="ExportActiveOrders_Click" Margin="0,0,6,0" Padding="12,8" FontSize="12"/>
                                <Button Content="Import Backup File" Style="{DynamicResource SecondaryButtonStyle}" Click="ImportBackup_Click" Margin="6,0,0,0" Padding="12,8" FontSize="12"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- OFFLINE MODE & LAN SYNC SECTION -->
                    <TextBlock Text="OFFLINE MODE &amp; LOCAL NETWORK (LAN)" Style="{DynamicResource BodyMd}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Margin="0,0,0,16" Opacity="0.8"/>
                    
                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,32">
                        <StackPanel>
                            <!-- Fully Offline Mode Checkbox -->
                            <DockPanel LastChildFill="True" Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Left" MaxWidth="340">
                                    <TextBlock Text="Enable Fully Offline Mode (LAN Sync Only)" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                    <TextBlock Text="Disconnects from Cloud servers completely. All job orders sync 100% locally via Wi-Fi/LAN between computers." Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="chkFullyOfflineModeGeneral" Style="{DynamicResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Separator Background="{DynamicResource OutlineBrush}" Margin="0,0,0,16" Opacity="0.3"/>

                            <!-- Force Local Push & Force Local Pull Buttons -->
                            <UniformGrid Columns="2">
                                <Button Content="🚀 Force Local Push (LAN)" Style="{DynamicResource SecondaryButtonStyle}" Click="ForceLocalPush_Click" Margin="0,0,6,0" Padding="12,8" FontSize="11"/>
                                <Button Content="📥 Force Local Pull (LAN)" Style="{DynamicResource SecondaryButtonStyle}" Click="ForceLocalPull_Click" Margin="6,0,0,0" Padding="12,8" FontSize="11"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ABOUT" Style="{DynamicResource BodyMd}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" FontSize="12" Margin="0,0,0,16" Opacity="0.8"/>
                    
                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,32">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Version" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                <TextBlock x:Name="txtVersion" Text="Loading..." Foreground="{DynamicResource OnSurfaceBrush}" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Environment" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                <TextBlock Text="Desktop Native" Foreground="{DynamicResource OnSurfaceBrush}" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Text="Database" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                <TextBlock Text="local_memos.db" Foreground="{DynamicResource OnSurfaceBrush}" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                            </DockPanel>

                            <Separator Background="{DynamicResource OutlineBrush}" Margin="0,0,0,16" Opacity="0.3"/>

                            <!-- Manual Update Check -->
                            <StackPanel>
                                <Button Content="Open Cloud Sync &amp; Force Sync Window" Style="{DynamicResource AccentedButtonStyle}" Click="OpenCloudSettings_Click" HorizontalAlignment="Stretch" Padding="12,8" FontSize="11" Margin="0,0,0,8"/>
                                <Button x:Name="btnCheckUpdates" Content="Check for Updates" Style="{DynamicResource SecondaryButtonStyle}" Click="CheckForUpdates_Click" HorizontalAlignment="Stretch" Padding="12,8" FontSize="11"/>
                                <TextBlock x:Name="txtUpdateCheckStatus" Text="" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Style="{DynamicResource PrimaryButtonStyle}" Content="Close &amp; Apply" Click="Save_Click" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
