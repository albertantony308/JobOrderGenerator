<Window x:Class="ClientApp.ConfirmSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch Workspace Confirmation" Height="440" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource OnSurfaceBrush}"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True">

    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1.5" CornerRadius="20" Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Window Header with Title and Close Drag bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SECURITY WARNING" FontSize="10" FontWeight="Bold" Foreground="#EF5350"/>
                    <TextBlock Text="Switch Workspace" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Width="28" Height="28" Click="Cancel_Click" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource OnSurfaceVariantBrush}" StrokeThickness="2" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10"/>
                </Button>
            </Grid>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Warning message -->
                    <TextBlock Text="You are switching workspaces. To prevent mixing data between different companies, your local database will be cleared before downloading the new company's data." 
                               TextWrapping="Wrap" FontSize="13" LineHeight="18" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,14"/>

                    <!-- Backup Status Card -->
                    <Border CornerRadius="12" Padding="14" Background="{DynamicResource SurfaceContainerLowBrush}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="LOCAL BACKUP STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblBackupStatus" Text="Checking backups..." FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblLastBackupTime" Text="" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud Subscription Prompt (Conditional Box) -->
                    <Border x:Name="CloudPromoBox" Visibility="Collapsed" CornerRadius="12" Padding="14" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Background="{DynamicResource SurfaceContainerLowBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CLOUD BACKUP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Enable cloud subscription to take cloud backups." FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{DynamicResource SecondaryButtonStyle}" Content="Upgrade Plan" Click="UpgradePlan_Click" Height="32" Padding="10,0" VerticalAlignment="Center" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{DynamicResource SecondaryButtonStyle}" Content="Cancel" Click="Cancel_Click" Margin="0,0,6,0" Height="40" Cursor="Hand"/>
                <Button Grid.Column="1" Style="{DynamicResource PrimaryButtonStyle}" Content="Clear &amp; Proceed" Click="Proceed_Click" Margin="6,0,0,0" Height="40" Background="#EF5350" BorderBrush="#EF5350" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
