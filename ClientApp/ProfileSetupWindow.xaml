<Window x:Class="ClientApp.ProfileSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Company Profile" Height="580" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="40" CornerRadius="12" Background="{DynamicResource SurfaceContainerLowestBrush}">
            <StackPanel>
                <TextBlock Text="Welcome!" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Set up your company profile to get started. This will be shared with all devices on this license." FontSize="14" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,30" TextWrapping="Wrap"/>
                
                <TextBlock Text="Company Name" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="CompanyNameInput" Padding="12" Margin="0,0,0,20" FontSize="16" Background="{DynamicResource SurfaceContainerHighestBrush}" Foreground="{DynamicResource OnSurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>
                

                <TextBlock Text="Email Address" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="EmailInput" Padding="12" Margin="0,0,0,30" FontSize="16" Background="{DynamicResource SurfaceContainerHighestBrush}" Foreground="{DynamicResource OnSurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"/>
                
                <Button x:Name="SaveButton" Content="Complete Setup" Padding="15" FontSize="16" FontWeight="SemiBold"
                        Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" BorderThickness="0"
                        Click="SaveButton_Click" Cursor="Hand">
                </Button>
                
                <TextBlock x:Name="ErrorText" Foreground="#ef4444" Margin="0,15,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
