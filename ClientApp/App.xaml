<Application x:Class="ClientApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClientApp"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PureLight.xaml"/>
                <ResourceDictionary Source="Theme.xaml"/>
                <ResourceDictionary Source="TemplateResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <sys:Double x:Key="AppFontSize">14</sys:Double>
            <sys:Double x:Key="HeadlineLgFontSize">32</sys:Double>
            <sys:Double x:Key="HeadlineMdFontSize">24</sys:Double>
            <sys:Double x:Key="HeadlineXsFontSize">20</sys:Double>
            <sys:Double x:Key="BodyMdFontSize">14</sys:Double>
            <sys:Double x:Key="BodySmFontSize">13</sys:Double>
            <sys:Double x:Key="CaptionFontSize">12</sys:Double>
            <sys:Double x:Key="LabelXsFontSize">10</sys:Double>
            
            <!-- Window base style -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
