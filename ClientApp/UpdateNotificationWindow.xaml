<Window x:Class="ClientApp.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update Available" 
        Height="450" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        BorderThickness="0"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}" Background="{DynamicResource SurfaceContainerLowestBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" Opacity="0.25" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtSparklesIcon" Text="✨" FontSize="28" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeaderTitle" Text="Minor Update Available" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock x:Name="txtVersionSubtitle" Text="Version 1.1.0 is ready to install" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Scrollable Content Layer -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <!-- Standard View: Changelog Details -->
                <ScrollViewer x:Name="scrollChangelog" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="WHAT'S NEW" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="10" Padding="14">
                            <TextBlock x:Name="txtChangelog" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>

                        <!-- Payment checkout container (only visible for unpaid major updates) -->
                        <Border x:Name="borderPayment" Visibility="Collapsed" Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="10" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="PREMIUM UPGRADE FEE REQUIRED" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtPaymentDetails" Text="This is a Major Upgrade ($19.99 USD) containing premium modules. Please complete checkout to continue." FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,12"/>
                                
                                <TextBlock Text="Cardholder Name" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtCardholder" Style="{DynamicResource InputStyle}" Margin="0,0,0,8" Tag="Name on Card"/>

                                <TextBlock Text="Card Number" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtCardNum" Style="{DynamicResource InputStyle}" Margin="0,0,0,8" Tag="1234 5678 9876 5432"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Expiry Date" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtExpiry" Style="{DynamicResource InputStyle}" Tag="MM/YY"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CVV" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtCVV" Style="{DynamicResource InputStyle}" Tag="123"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Processing Payment Overlay -->
                <Grid x:Name="gridLoader" Visibility="Collapsed" Background="{DynamicResource SurfaceContainerLowestBrush}" Opacity="0.95">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="4" Width="150" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource SurfaceContainerBrush}" BorderThickness="0" Margin="0,0,0,12"/>
                        <TextBlock x:Name="txtLoaderStatus" Text="Processing Payment..." FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource OnSurfaceBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Do It Later / Postpone -->
                <Button x:Name="btnLater" Grid.Column="0" Content="Do It Later" Click="Later_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,12,0" HorizontalAlignment="Left" Padding="16,8"/>
                
                <!-- Action (Update Now / Pay & Upgrade) -->
                <Button x:Name="btnAction" Grid.Column="1" Content="Update Now" Click="Action_Click" Style="{DynamicResource PrimaryButtonStyle}" Padding="20,10"/>
            </Grid>
        </Grid>
    </Border>
</Window>
