<Window x:Class="ClientApp.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update" 
        Height="480" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        BorderThickness="0"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}" Background="{DynamicResource SurfaceContainerLowestBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.3" ShadowDepth="6"/>
        </Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="borderHeaderIcon" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource SurfaceContainerLowBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtSparklesIcon" Text="✨" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="txtHeaderTitle" Text="Software Update Available" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource PrimaryBrush}"/>
                    <TextBlock x:Name="txtVersionSubtitle" Text="Version 1.2.3 is ready" FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Main Content Area (Changelog vs Download View) -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <!-- 1. Initial View: Changelog Details & Description -->
                <Grid x:Name="gridChangelogView" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Compulsory Notice Banner if strict -->
                            <Border x:Name="borderCompulsoryNotice" Visibility="Collapsed" Background="#FFFDF2F2" BorderBrush="#FFDC2626" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="This is a compulsory update. Installation is required to continue." FontSize="11" FontWeight="SemiBold" Foreground="#FFDC2626" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="WHAT'S NEW IN THIS VERSION" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SurfaceContainerBrush}" CornerRadius="12" Padding="16">
                                <TextBlock x:Name="txtChangelog" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" TextWrapping="Wrap" LineHeight="19"/>
                            </Border>

                            <!-- Payment checkout container (only visible for unpaid major updates) -->
                            <Border x:Name="borderPayment" Visibility="Collapsed" Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="10" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" Padding="14" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="PREMIUM UPGRADE FEE REQUIRED" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtPaymentDetails" Text="This is a Major Upgrade ($19.99 USD) containing premium modules. Please complete checkout to continue." FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,12"/>
                                    
                                    <TextBlock Text="Cardholder Name" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtCardholder" Style="{DynamicResource InputStyle}" Margin="0,0,0,8" Tag="Name on Card"/>

                                    <TextBlock Text="Card Number" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtCardNum" Style="{DynamicResource InputStyle}" Margin="0,0,0,8" Tag="1234 5678 9876 5432"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Expiry Date" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtExpiry" Style="{DynamicResource InputStyle}" Tag="MM/YY"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CVV" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtCVV" Style="{DynamicResource InputStyle}" Tag="123"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 2. Interactive Download Screen (Progress Bar & Live Percentage) -->
                <Grid x:Name="gridDownloadView" Visibility="Collapsed" Background="{DynamicResource SurfaceContainerLowestBrush}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="12,0">
                        <TextBlock Text="DOWNLOADING UPDATE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        
                        <!-- Percentage Display -->
                        <TextBlock x:Name="txtPercent" Text="0.0%" FontSize="36" FontWeight="ExtraBold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Progress Bar -->
                        <ProgressBar x:Name="pbDownload" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource SurfaceContainerBrush}" BorderThickness="0" Margin="0,0,0,16">
                            <ProgressBar.Resources>
                                <Style TargetType="Rectangle">
                                    <Setter Property="RadiusX" Value="5"/>
                                    <Setter Property="RadiusY" Value="5"/>
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>

                        <!-- Bytes / Status Text -->
                        <TextBlock x:Name="txtDownloadDetails" Text="Connecting to update server..." FontSize="12" Foreground="{DynamicResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Buttons Grid -->
            <Grid Grid.Row="2" x:Name="gridButtons">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Do It Later / Postpone (Hidden for compulsory updates or during download) -->
                <Button x:Name="btnLater" Grid.Column="0" Content="Do It Later" Click="Later_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,12,0" HorizontalAlignment="Left" Padding="18,9"/>
                
                <!-- Action Button (Update Now / Download & Install / Install Now) -->
                <Button x:Name="btnAction" Grid.Column="1" Content="Update Now" Click="Action_Click" Style="{DynamicResource PrimaryButtonStyle}" Padding="22,10"/>
            </Grid>
        </Grid>
    </Border>
</Window>
