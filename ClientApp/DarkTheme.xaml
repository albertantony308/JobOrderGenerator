<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Dark Mode Colors (Premium Midnight) -->
    <Color x:Key="BackgroundColor">#0a0a0c</Color>
    <Color x:Key="SurfaceColor">#0a0a0c</Color>
    <Color x:Key="SurfaceContainerLowColor">#16181d</Color>
    <Color x:Key="SurfaceContainerColor">#212429</Color>
    <Color x:Key="SurfaceContainerHighColor">#2b2f36</Color>
    <Color x:Key="SurfaceContainerHighestColor">#363b43</Color>
    <Color x:Key="SurfaceContainerLowestColor">#050505</Color>
    
    <Color x:Key="PrimaryColor">#4d7cff</Color>
    <Color x:Key="PrimaryContainerColor">#2c3e6b</Color>
    <Color x:Key="OnPrimaryColor">#ffffff</Color>
    
    <Color x:Key="OnSurfaceColor">#f0f0f5</Color>
    <Color x:Key="OnSurfaceVariantColor">#a0abb6</Color>
    <Color x:Key="OutlineColor">#40464c</Color>

    <Color x:Key="StatusPendingColor">#3d3300</Color>
    <Color x:Key="OnStatusPendingColor">#ffe082</Color>
    <Color x:Key="StatusInProgressColor">#00335c</Color>
    <Color x:Key="OnStatusInProgressColor">#90caf9</Color>
    <Color x:Key="StatusCompletedColor">#003d00</Color>
    <Color x:Key="OnStatusCompletedColor">#a5d6a7</Color>
    <Color x:Key="StatusRepeatedColor">#311b92</Color>
    <Color x:Key="OnStatusRepeatedColor">#d1c4e9</Color>
    <Color x:Key="StatusRejectedColor">#4a0e0e</Color>
    <Color x:Key="OnStatusRejectedColor">#ef5350</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#0a0a0c"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0a0a0c"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#16181d"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#212429"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#2b2f36"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#363b43"/>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#050505"/>
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4d7cff"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#2c3e6b"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#ffffff"/>
    
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#f0f0f5"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#a0abb6"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#40464c"/>
 
    <!-- Status Brushes -->
    <SolidColorBrush x:Key="StatusPendingBrush" Color="#3d3300"/>
    <SolidColorBrush x:Key="OnStatusPendingBrush" Color="#ffe082"/>
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="#00335c"/>
    <SolidColorBrush x:Key="OnStatusInProgressBrush" Color="#90caf9"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#003d00"/>
    <SolidColorBrush x:Key="OnStatusCompletedBrush" Color="#a5d6a7"/>
    <SolidColorBrush x:Key="StatusRepeatedBrush" Color="#311b92"/>
    <SolidColorBrush x:Key="OnStatusRepeatedBrush" Color="#d1c4e9"/>
    <SolidColorBrush x:Key="StatusRejectedBrush" Color="#4a0e0e"/>
    <SolidColorBrush x:Key="OnStatusRejectedBrush" Color="#ef5350"/>

    <!-- WhatsApp Specific (Solid Vibrant Green) -->
    <SolidColorBrush x:Key="WhatsAppBrush" Color="#25D366"/>
    <SolidColorBrush x:Key="WhatsAppHoverBrush" Color="#128C7E"/>
    <SolidColorBrush x:Key="OnWhatsAppBrush" Color="White"/>

    <!-- Close Button -->
    <SolidColorBrush x:Key="CloseButtonBrush" Color="#f0f0f5"/>

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#20ffffff"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#80ffffff"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A0ffffff"/>
</ResourceDictionary>
