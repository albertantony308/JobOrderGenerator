<Window x:Class="ClientApp.MemoDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        Title="Order Details" Height="750" Width="950"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        FontSize="{DynamicResource AppFontSize}">

    <Window.Resources>
        <!-- Modern styled CalendarItem -->
        <Style x:Key="ModernCalendarItemStyle" TargetType="CalendarItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <Grid x:Name="PART_Root" Background="Transparent">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="16">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Previous Button -->
                                        <Button x:Name="PART_PreviousButton" Grid.Column="0" Focusable="False" Height="32" Width="32" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OnSurfaceBrush}" Opacity="0.8">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <TextBlock Text="◀" FontSize="11" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Month/Year Header Button -->
                                        <Button x:Name="PART_HeaderButton" Grid.Column="1" Focusable="False" FontWeight="Bold" FontSize="14" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OnSurfaceBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="8,4" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Next Button -->
                                        <Button x:Name="PART_NextButton" Grid.Column="2" Focusable="False" Height="32" Width="32" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource OnSurfaceBrush}" Opacity="0.8">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <TextBlock Text="▶" FontSize="11" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- Views Grid -->
                                    <Grid Grid.Row="1">
                                        <!-- Month View: 7 Columns x 7 Rows -->
                                        <Grid x:Name="PART_MonthView" Visibility="Visible">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                        </Grid>

                                        <!-- Year View: 3 Columns x 4 Rows -->
                                        <Grid x:Name="PART_YearView" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                        </Grid>

                                        <!-- Decade View: 3 Columns x 4 Rows -->
                                        <Grid x:Name="PART_DecadeView" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="PART_PreviousButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_PreviousButton" Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
                                <Setter TargetName="PART_PreviousButton" Property="Opacity" Value="1.0"/>
                            </Trigger>
                            <Trigger SourceName="PART_HeaderButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_HeaderButton" Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
                            </Trigger>
                            <Trigger SourceName="PART_NextButton" Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_NextButton" Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
                                <Setter TargetName="PART_NextButton" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern styled CalendarDayButton -->
        <Style x:Key="ModernCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="3">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Destructive Outline Button Style -->
        <Style x:Key="DestructiveOutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnStatusRejectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OnStatusRejectedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource StatusRejectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background with Shadow -->
        <Border Background="{DynamicResource SurfaceContainerLowestBrush}" 
                CornerRadius="24" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                Margin="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" Opacity="0.15" ShadowDepth="5" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Panel -->
                <Grid Grid.Row="0" Margin="32,32,32,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtMemoNumber" Style="{DynamicResource HeadlineMd}" Text="SM-1234" Margin="0,0,12,4"/>
                            <Button x:Name="btnRefreshDetails" Content="🔄" Width="36" Height="36" 
                                    Style="{DynamicResource SecondaryButtonStyle}" 
                                    Padding="0" Margin="0,0,0,4" Cursor="Hand"
                                    Click="RefreshDetails_Click" ToolTip="Refresh from Database and Cloud"/>
                        </StackPanel>
                        <TextBlock x:Name="txtDate" Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="{DynamicResource BodySmFontSize}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                            <TextBlock Text="STATUS" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Black" Opacity="0.4" FontSize="{DynamicResource LabelXsFontSize}" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <ComboBox x:Name="cmbStatus" Width="180" Height="44" BorderThickness="0" Background="Transparent" SelectionChanged="Status_Changed">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Grid>
                                                        <ToggleButton x:Name="ToggleButton" 
                                                                    BorderThickness="0"
                                                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                    Cursor="Hand">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="border" CornerRadius="22">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource StatusPendingBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="In Progress">
                                                                                        <Setter Property="Background" Value="{DynamicResource StatusInProgressBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="Completed">
                                                                                        <Setter Property="Background" Value="{DynamicResource StatusCompletedBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="Repeated">
                                                                                        <Setter Property="Background" Value="{DynamicResource StatusRepeatedBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="Rejected">
                                                                                        <Setter Property="Background" Value="{DynamicResource StatusRejectedBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="40"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                                            <Path Grid.Column="1" Data="M0,0 L5,5 L10,0" StrokeThickness="2.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                <Path.Style>
                                                                                    <Style TargetType="Path">
                                                                                        <Setter Property="Stroke" Value="{DynamicResource OnStatusPendingBrush}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="In Progress">
                                                                                                <Setter Property="Stroke" Value="{DynamicResource OnStatusInProgressBrush}"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="Completed">
                                                                                                <Setter Property="Stroke" Value="{DynamicResource OnStatusCompletedBrush}"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="Repeated">
                                                                                                <Setter Property="Stroke" Value="{DynamicResource OnStatusRepeatedBrush}"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="Rejected">
                                                                                                <Setter Property="Stroke" Value="{DynamicResource OnStatusRejectedBrush}"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Path.Style>
                                                                            </Path>
                                                                            </Grid>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            
                                                        <!-- Selected Item Text with Modern Font and High Contrast -->
                                                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                                                        Content="{TemplateBinding SelectionBoxItem}"
                                                                        Margin="12,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <ContentPresenter.Resources>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="ExtraBold"/>
                                                                    <Setter Property="FontSize" Value="{DynamicResource BodySmFontSize}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnStatusPendingBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="In Progress">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnStatusInProgressBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="Completed">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnStatusCompletedBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="Repeated">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnStatusRepeatedBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="Rejected">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnStatusRejectedBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentPresenter.Resources>
                                                        </ContentPresenter>
    
                                                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                                            <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource OutlineBrush}" Margin="0,10,0,0" Padding="6" MinWidth="180">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
                                                                </Border.Effect>
                                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.Style>
                                 <!-- Item Container Style for Premium Visuals -->
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Border x:Name="ItemBorder" CornerRadius="14" Padding="16,12" Margin="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource StatusPendingBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding}" Value="In Progress">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusInProgressBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="Completed">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusCompletedBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding}" Value="Rejected">
                                                                        <Setter Property="Background" Value="{DynamicResource StatusRejectedBrush}"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                                        <Setter Property="Opacity" Value="0.9"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ContentPresenter HorizontalAlignment="Center">
                                                            <ContentPresenter.Resources>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="Black"/>
                                                                    <Setter Property="FontSize" Value="{DynamicResource BodySmFontSize}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource OnStatusPendingBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding}" Value="In Progress">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnStatusInProgressBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding}" Value="Completed">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnStatusCompletedBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding}" Value="Rejected">
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnStatusRejectedBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentPresenter.Resources>
                                                        </ContentPresenter>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
    
                                <System:String>Pending</System:String>
                                <System:String>In Progress</System:String>
                                <System:String>Completed</System:String>
                                <System:String>Rejected</System:String>
                            </ComboBox>
                        </StackPanel>
 
                        </StackPanel>
                    </Grid>
                
                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" Margin="32,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
 
                        <!-- Left: Main Details -->
                        <StackPanel Grid.Column="0" Margin="0,0,32,0">
                            <TextBlock Text="CUSTOMER INFORMATION" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="16,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="👤" FontSize="{DynamicResource HeadlineXsFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtCustomerName" Text="John Doe" FontSize="{DynamicResource HeadlineMdFontSize}" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                        <TextBlock x:Name="txtPhoneNumber" Text="+1 234 567 890" FontSize="{DynamicResource BodyMdFontSize}" Foreground="{DynamicResource OnSurfaceBrush}" Opacity="0.8" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="txtCustomerAddress" Text="123 Main St, Springfield" FontSize="{DynamicResource BodySmFontSize}" Foreground="{DynamicResource OnSurfaceVariantBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <StackPanel x:Name="AlternativeContactsPanel" Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="txtPhone2" Text="Phone 2: 456" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" Opacity="0.7"/>
                                        </StackPanel>
                                        <StackPanel x:Name="TechnicianPanel" Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="👷 Assigned Staff:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Opacity="0.9"/>
                                            <TextBlock x:Name="txtTechnician" Text="Tech: Name" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="COST ESTIMATION" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,24">
                                <StackPanel>
                                    <DataGrid x:Name="dgCostItems" 
                                              AutoGenerateColumns="False" 
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              RowHeaderWidth="0"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{DynamicResource OutlineBrush}"
                                              Style="{DynamicResource DataGridStyle}"
                                              MinHeight="120"
                                              MaxHeight="250"
                                              Foreground="{DynamicResource OnSurfaceBrush}"
                                              HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Item / Service" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource BodyMd}">
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
                                                        <Setter Property="Padding" Value="4"/>
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Cost (Rs.)" Binding="{Binding Cost, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="150" ElementStyle="{StaticResource BodyMd}">
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
                                                        <Setter Property="Padding" Value="4"/>
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    
                                    <!-- Action buttons -->
                                    <Grid Margin="0,12,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="➕ Add Item" Style="{DynamicResource SecondaryButtonStyle}" Width="140" Padding="12,8" Click="AddCostItem_Click"/>
                                        <Button Grid.Column="1" Content="🗑️ Remove Selected" Style="{DynamicResource DestructiveOutlineButtonStyle}" Width="170" Padding="12,8" Click="RemoveCostItem_Click"/>
                                    </Grid>

                                    <Border BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="💰 Total Cost: " FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                                <TextBlock x:Name="txtTotalCost" Text="Rs. 0.00" FontSize="16" FontWeight="Black" Foreground="{DynamicResource PrimaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="BRAND" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="20">
                                        <TextBlock x:Name="txtBrand" Text="Apple" FontSize="{DynamicResource BodyMdFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Device Model Card -->
                                <StackPanel Grid.Column="2" Margin="0,0,0,16">
                                    <TextBlock Text="MODEL NUMBER" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="20">
                                        <TextBlock x:Name="txtDeviceModel" Text="A2638" FontSize="{DynamicResource BodyMdFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Device Name Card -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="DEVICE NAME" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="20">
                                        <TextBlock x:Name="txtDeviceName" Text="iPhone 13 Pro" FontSize="{DynamicResource BodyMdFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Serial Number Card -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SERIAL NUMBER" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="20">
                                        <TextBlock x:Name="txtSerialNumber" Text="SN123456789" FontSize="{DynamicResource BodyMdFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="ACCESSORIES" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,24">
                                <TextBlock x:Name="txtAccessories" Text="Charger, Case, Box" 
                                           FontSize="15" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            </Border>

                            <TextBlock Text="REPORTED ISSUE" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,24">
                                <TextBlock x:Name="txtIssue" Text="Screen cracked and battery draining fast." 
                                           FontSize="15" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            </Border>

                            <TextBlock Text="DIAGNOSTICS &amp; NOTES" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,24">
                                <TextBlock x:Name="txtDiagnostics" Text="Internal diagnostic shows 78% battery health." 
                                           FontSize="15" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource OnSurfaceBrush}" FontStyle="Italic"/>
                            </Border>
                        </StackPanel>
                        <!-- Right Side Panel -->
                        <StackPanel Grid.Column="1">
                            <StackPanel x:Name="sectionPhotos" Visibility="Collapsed">
                                <TextBlock Text="DEVICE PHOTOS" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                <Border x:Name="imgContainer" Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Height="220" Margin="0,0,0,24" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="imgProduct" Source="https://img.icons8.com/fluency/96/image.png" Stretch="UniformToFill" Cursor="Hand" MouseLeftButtonDown="Image_Click"/>
                                        <Grid VerticalAlignment="Bottom" Background="#80000000" Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnPrev" Grid.Column="0" Content="◀" Background="Transparent" BorderThickness="0" Foreground="White" Width="40" Click="PrevImage_Click"/>
                                            <TextBlock x:Name="txtImageCounter" Grid.Column="1" Text="1 of 3" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="11"/>
                                            <Button x:Name="btnNext" Grid.Column="2" Content="▶" Background="Transparent" BorderThickness="0" Foreground="White" Width="40" Click="NextImage_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Repeated Device Info Badge -->
                            <Border x:Name="RepeatedDeviceBadge" Visibility="Collapsed" 
                                    Background="#FCE8E6" BorderBrush="#F44336" BorderThickness="1" 
                                    CornerRadius="12" Padding="16,12" Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Warning Alert Icon -->
                                    <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zm1,15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                                          Fill="#D93025" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Repeated Device Alert" FontWeight="Bold" FontSize="13" Foreground="#C5221F"/>
                                        <TextBlock Text="This device is identified as a repeated device." FontSize="11" Foreground="#C5221F" Opacity="0.85" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ORDER UPDATE" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="24" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBox x:Name="txtOrderUpdates" PreviewKeyDown="txtOrderUpdates_PreviewKeyDown" 
                                             Style="{DynamicResource InputStyle}"
                                             Height="70"
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True" 
                                             FontSize="13"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,16"
                                             Tag="Write what all updates have been made to the order..."/>
                                    <Button Content="Update" 
                                            Style="{DynamicResource PrimaryButtonStyle}" 
                                            HorizontalAlignment="Stretch"
                                            Click="UpdateOrder_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- WhatsApp Completion Notification Section -->
                            <StackPanel x:Name="whatsappSection" Visibility="Collapsed" Margin="0,0,0,16">
                                <Button x:Name="btnToggleWhatsApp" 
                                        Content="💬 Send Ready Status via WhatsApp" 
                                        Style="{DynamicResource SecondaryButtonStyle}" 
                                        Padding="12,8" 
                                        HorizontalAlignment="Stretch" 
                                        Click="ToggleWhatsApp_Click"
                                        Margin="0,0,0,8"/>
                                <Border x:Name="whatsappMessagePanel" Visibility="Collapsed" Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="16" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Message to Customer" FontSize="11" Opacity="0.7" Margin="0,0,0,8" Foreground="{DynamicResource OnPrimaryContainerBrush}"/>
                                        <TextBox x:Name="txtWhatsAppMessage" 
                                                 Style="{DynamicResource InputStyle}"
                                                 Height="60"
                                                 TextWrapping="Wrap" 
                                                 AcceptsReturn="True" 
                                                 FontSize="13"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Margin="0,0,0,12"/>
                                        <Button Background="{DynamicResource WhatsAppBrush}"
                                                Foreground="{DynamicResource OnWhatsAppBrush}"
                                                Height="40"
                                                Cursor="Hand"
                                                Click="SendWhatsApp_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource WhatsAppHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💬" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16"/>
                                                    <TextBlock Text="Send via WhatsApp" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Return Date Section -->
                            <TextBlock Text="RETURN DATE" Style="{DynamicResource BodyMd}" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,8" Foreground="{DynamicResource OnSurfaceBrush}"/>
                            <Border Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,24">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource PrimaryContainerBrush}" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="📅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Return / Pickup Date" FontSize="11" Opacity="0.55" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="txtReturnDateDisplay" Text="Not Set" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Quick Buttons & Picker Action -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Today Button -->
                                        <Button x:Name="btnToday" Grid.Column="0" Content="Today" Click="QuickDate_Click" Tag="0" Height="36" Cursor="Hand" Background="Transparent" Foreground="{DynamicResource OnSurfaceBrush}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <!-- Remove Date Button -->
                                        <Button x:Name="btnRemoveDate" Grid.Column="2" Content="Remove Date" Click="ClearReturnDate_Click" Height="36" Cursor="Hand" Background="Transparent" Foreground="#EF5350">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DestructiveRedBrush}"/>
                                                            <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OnDestructiveRedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        
                                        <!-- Custom Picker Toggle -->
                                        <Button x:Name="btnToggleCalendar" Grid.Column="4" Height="36" Cursor="Hand" Click="btnToggleCalendar_Click" Background="Transparent" Foreground="{DynamicResource OnSurfaceBrush}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="8">
                                                        <TextBlock x:Name="txtIcon" Text="📅" FontSize="15" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- Popup Calendar Picker Overlay -->
                                    <Popup x:Name="popCalendar" PlacementTarget="{Binding ElementName=btnToggleCalendar}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide" StaysOpen="False">
                                        <Border Background="{DynamicResource SurfaceContainerLowestBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="16" Padding="8" Margin="0,4,0,12">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="15" Opacity="0.15" ShadowDepth="3" Direction="270"/>
                                            </Border.Effect>
                                            <Calendar x:Name="calReturnDate" SelectedDatesChanged="CalendarDate_Changed" 
                                                      BorderThickness="0" BorderBrush="Transparent"
                                                      Background="Transparent" Foreground="{DynamicResource OnSurfaceBrush}" Padding="12" 
                                                      HorizontalAlignment="Center"
                                                      CalendarItemStyle="{StaticResource ModernCalendarItemStyle}"
                                                      CalendarDayButtonStyle="{StaticResource ModernCalendarDayButtonStyle}">
                                                <Calendar.Resources>
                                                    <!-- Custom day title template for week day headers (e.g. Su, Mo, Tu...) -->
                                                    <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                                        <TextBlock Text="{Binding}" 
                                                                   Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="11" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   Margin="0,4,0,8"/>
                                                    </DataTemplate>
                                                    <!-- Style for the Header navigation buttons and month/year selector -->
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Opacity" Value="0.85"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <!-- Style for Month/Year selection buttons in Year/Decade view -->
                                                    <Style TargetType="CalendarButton">
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
                                                        <Setter Property="MinWidth" Value="42"/>
                                                        <Setter Property="MinHeight" Value="42"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="CalendarButton">
                                                                    <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Margin="2">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Calendar.Resources>
                                            </Calendar>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer Actions -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="0,0,24,24" Padding="32,24">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{DynamicResource SecondaryButtonStyle}" Content="Close Window" Width="140" Margin="0,0,12,0" Click="Close_Click"/>
                            <Button Style="{DynamicResource DestructiveOutlineButtonStyle}" Content="Delete Entry" Width="140" Click="Delete_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource SecondaryButtonStyle}" Content="Modify Entry" Width="140" Margin="0,0,12,0" Click="Edit_Click"/>
                            <Button Style="{DynamicResource PrimaryButtonStyle}" Content="Print / Export PDF" Width="180" Click="Print_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Image Preview Popup -->
        <Border x:Name="imgPopup" Visibility="Collapsed" Background="#F0000000" MouseLeftButtonDown="ClosePopup_Click">
            <Grid>
                <Image x:Name="imgFull" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="32" Width="48" Height="48" Background="#40FFFFFF" BorderThickness="0" Click="ClosePopup_Click">
                    <TextBlock Text="✕" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- Windows Style Close Button -->
        <Button Style="{DynamicResource WindowsCloseButtonStyle}" 
                HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,20,20,0" Click="Close_Click"/>
    </Grid>
</Window>
