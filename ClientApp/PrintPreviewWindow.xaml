<Window x:Class="ClientApp.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview" Height="800" Width="1000" MinHeight="550"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="16"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseControlButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E81123"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" CornerRadius="10" Background="{DynamicResource SurfaceContainerHighBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource OnSurfaceVariantBrush}" HorizontalAlignment="Left" Margin="2">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar ListBoxItem Style -->
        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,4" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="{DynamicResource SurfaceContainerLowestBrush}" CornerRadius="16" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" Margin="8">
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.1" ShadowDepth="2" Direction="270"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Height="32">
                    <TextBlock Text="Print Preview" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="11" FontWeight="SemiBold" Opacity="0.8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowControlButtonStyle}" Click="Minimize_Click"><Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                        <Button x:Name="btnMaximize" Style="{StaticResource WindowControlButtonStyle}" Click="Maximize_Click"><Border Width="10" Height="10" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1"/></Button>
                        <Button Style="{StaticResource CloseControlButtonStyle}" Click="Close_Click"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceContainerLowBrush}" CornerRadius="0,0,0,16" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Settings" Foreground="{DynamicResource OnSurfaceBrush}" Style="{DynamicResource HeadlineSmall}" Margin="0,0,0,4"/>
                                <TextBlock Text="Customize output." Foreground="{DynamicResource OnSurfaceVariantBrush}" FontSize="12"/>
                            </StackPanel>
                            <ScrollViewer x:Name="SidebarScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Text="SELECT PRINTER" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="Bold" FontSize="11" Opacity="0.7" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="PrinterList" Style="{DynamicResource PremiumComboBoxStyle}" Height="40" Margin="0,0,0,24"/>
                                    
                                    <TextBlock Text="PAPER SIZE" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,12"/>
                                    
                                    <ListBox x:Name="PaperSizeList" Background="Transparent" BorderThickness="0" SelectionChanged="PaperSize_Changed" PreviewMouseWheel="ListBox_PreviewMouseWheel" Margin="0,0,0,24" ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                                        <ListBoxItem Tag="A4" IsSelected="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📏" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="A4 Paper Size" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="A5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📐" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="A5 Paper Size" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="A6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📐" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="A6 Paper Size" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="Letter">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✉️" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="Letter Paper Size" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                    </ListBox>

                                    <TextBlock Text="NUMBER OF COPIES" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,12"/>
                                    <ComboBox x:Name="cmbCopies" SelectedIndex="0" Padding="12,8" Margin="0,0,0,24" FontSize="13" Style="{DynamicResource PremiumComboBoxStyle}" SelectionChanged="Copies_Changed">
                                        <ComboBoxItem Tag="1" Content="1 Copy"/>
                                        <ComboBoxItem Tag="2" Content="2 Copies"/>
                                        <ComboBoxItem Tag="3" Content="3 Copies"/>
                                        <ComboBoxItem Tag="4" Content="4 Copies"/>
                                        <ComboBoxItem Tag="5" Content="5 Copies"/>
                                        <ComboBoxItem Tag="10" Content="10 Copies"/>
                                    </ComboBox>

                                    <TextBlock Text="PAGE MARGINS" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="Bold" FontSize="11" Opacity="0.7" Margin="0,0,0,12"/>

                                    <ListBox x:Name="MarginsList" Background="Transparent" BorderThickness="0" SelectionChanged="Margins_Changed" PreviewMouseWheel="ListBox_PreviewMouseWheel" Margin="0,0,0,24" ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                                        <ListBoxItem Tag="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⬜" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="No Border" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                    <TextBlock Text="0 mm" FontSize="10" Opacity="0.6" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="18">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▫" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="Narrow" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                    <TextBlock Text="6 mm all sides" FontSize="10" Opacity="0.6" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="40" IsSelected="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔲" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="Normal" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                    <TextBlock Text="13 mm all sides" FontSize="10" Opacity="0.6" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="72">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⬛" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="Wide" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                    <TextBlock Text="24 mm all sides" FontSize="10" Opacity="0.6" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </ListBoxItem>
                                    </ListBox>

                                    <TextBlock Text="PAGE ARRANGEMENT" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,12"/>
                                    
                                    <ListBox x:Name="ArrangementList" Background="Transparent" BorderThickness="0" SelectionChanged="Arrangement_Changed" PreviewMouseWheel="ListBox_PreviewMouseWheel" Margin="0,0,0,24" ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                                        <ListBoxItem Tag="Single" IsSelected="True">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📄" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="Single Memo" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="HalfA4Top">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔼" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="Top Half Only" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="HalfA4Bottom">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔽" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="Bottom Half Only" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="RotatedHalf">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔄" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="Side-Turned Half" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="2v">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📑" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="2 Stacked (Vertical)" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="2h">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📖" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="2 Side-by-Side" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="4grid">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▦" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="4 per Page (2x2)" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="8grid">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🍱" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="8 per Page (2x4)" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem Tag="12grid">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📅" Margin="0,0,12,0" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                <TextBlock Text="12 per Page (3x4)" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                            </StackPanel>
                                        </ListBoxItem>
                                    </ListBox>

                                    <!-- Optional details filters are hidden from view to clean up sidebar layout -->
                                    <StackPanel Visibility="Collapsed">
                                        <TextBlock Text="Options" Foreground="{DynamicResource OnSurfaceBrush}" FontWeight="Bold" FontSize="11" Opacity="0.7" Margin="0,0,0,12"/>
                                        <CheckBox Content="Include Model Info" x:Name="chkShowModel" IsChecked="True" Style="{DynamicResource ToggleSwitchStyle}" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,10"/>
                                        <CheckBox Content="Include Diagnostics" x:Name="chkShowDiagnostics" IsChecked="True" Style="{DynamicResource ToggleSwitchStyle}" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,10"/>
                                        <CheckBox Content="Include Estimated Cost" x:Name="chkShowCost" IsChecked="True" Style="{DynamicResource ToggleSwitchStyle}" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,16"/>
                                    </StackPanel>
                                    
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Margin="0,16,0,20">
                                <Button Style="{DynamicResource PrimaryButtonStyle}" Content="Print Order" Click="Print_Click" Height="40" FontSize="13" Padding="16,6"/>
                                <Button Style="{DynamicResource SecondaryButtonStyle}" Content="🎨 Customize Memo Style" Click="CustomizeMemoStyle_Click" Height="40" FontSize="13" Margin="0,8,0,0" Padding="16,6"/>
                                <Button Style="{DynamicResource SecondaryButtonStyle}" Content="Back" Click="Close_Click" Margin="0,8,0,0" Height="40" FontSize="13" Padding="16,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Preview Area with Scroll & Zoom -->
                        <ScrollViewer x:Name="PreviewScrollViewer" Grid.Row="0" 
                                      HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Padding="40"
                                      PreviewMouseLeftButtonDown="PreviewScrollViewer_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="PreviewScrollViewer_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="PreviewScrollViewer_PreviewMouseLeftButtonUp">
                            <Grid x:Name="ZoomContainer" 
                                  RenderTransformOrigin="0.5,0.5"
                                  IsManipulationEnabled="True"
                                  ManipulationDelta="ZoomContainer_ManipulationDelta">
                                <Border x:Name="PrintArea" 
                                        Width="794" Height="1123" 
                                        Background="White" 
                                        TextElement.Foreground="Black"
                                        BorderBrush="{DynamicResource OutlineBrush}" 
                                        BorderThickness="1"
                                        x:FieldModifier="private">
                                    <Border.LayoutTransform>
                                        <ScaleTransform x:Name="PreviewScale" ScaleX="0.5" ScaleY="0.5"/>
                                    </Border.LayoutTransform>
                                    <Grid>
                                        <ContentControl x:Name="PrintContent" Content="{Binding}"/>
                                        <!-- Margin guide overlay — drawn by code, never affects layout -->
                                        <Canvas x:Name="MarginGuideOverlay" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
 
                        <!-- Zoom Controls Overlay/Panel -->
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceContainerLowBrush}" 
                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,1,0,0"
                                Padding="16,8" CornerRadius="0,0,16,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{DynamicResource SecondaryButtonStyle}" Content="Zoom Out (-)" Click="ZoomOut_Click" Padding="16,6" Margin="0,0,8,0"/>
                                <Border Background="{DynamicResource SurfaceContainerHighestBrush}" CornerRadius="4" Padding="12,4" Margin="0,0,8,0">
                                    <TextBlock x:Name="txtZoomPercent" Text="50%" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}"/>
                                </Border>
                                <Button Style="{DynamicResource SecondaryButtonStyle}" Content="Zoom In (+)" Click="ZoomIn_Click" Padding="16,6" Margin="0,0,8,0"/>
                                <Button Style="{DynamicResource SecondaryButtonStyle}" Content="Reset Zoom" Click="ResetZoom_Click" Padding="16,6"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
