<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ice Dark Theme -->
    <Color x:Key="BackgroundColor">#0f172a</Color>
    <Color x:Key="SurfaceColor">#0f172a</Color>
    <Color x:Key="SurfaceContainerLowColor">#1e293b</Color>
    <Color x:Key="SurfaceContainerColor">#334155</Color>
    <Color x:Key="SurfaceContainerHighColor">#475569</Color>
    <Color x:Key="SurfaceContainerHighestColor">#64748b</Color>
    <Color x:Key="SurfaceContainerLowestColor">#020617</Color>
    
    <Color x:Key="PrimaryColor">#38bdf8</Color>
    <Color x:Key="PrimaryContainerColor">#1e293b</Color>
    <Color x:Key="OnPrimaryColor">#ffffff</Color>

    <Color x:Key="StatusPendingColor">#2d2400</Color>
    <Color x:Key="OnStatusPendingColor">#fde047</Color>
    <Color x:Key="StatusInProgressColor">#0f172a</Color>
    <Color x:Key="OnStatusInProgressColor">#38bdf8</Color>
    <Color x:Key="StatusCompletedColor">#062a1a</Color>
    <Color x:Key="OnStatusCompletedColor">#4ade80</Color>
    <Color x:Key="StatusRepeatedColor">#311b92</Color>
    <Color x:Key="OnStatusRepeatedColor">#d1c4e9</Color>
    <Color x:Key="StatusRejectedColor">#2d0d0d</Color>
    <Color x:Key="OnStatusRejectedColor">#fca5a5</Color>
    
    <Color x:Key="OnSurfaceColor">#f1f5f9</Color>
    <Color x:Key="OnSurfaceVariantColor">#94a3b8</Color>
    <Color x:Key="OutlineColor">#334155</Color>
    <Color x:Key="TertiaryColor">#ffffff</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#0f172a"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0f172a"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#1e293b"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#475569"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#64748b"/>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#020617"/>
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="#38bdf8"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#1e293b"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#f1f5f9"/>

    <SolidColorBrush x:Key="TertiaryBrush" Color="White"/>
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#1e293b"/>
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="#38bdf8"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#94a3b8"/>

    <SolidColorBrush x:Key="StatusPendingBrush" Color="{DynamicResource StatusPendingColor}"/>
    <SolidColorBrush x:Key="OnStatusPendingBrush" Color="{DynamicResource OnStatusPendingColor}"/>
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="{DynamicResource StatusInProgressColor}"/>
    <SolidColorBrush x:Key="OnStatusInProgressBrush" Color="{DynamicResource OnStatusInProgressColor}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{DynamicResource StatusCompletedColor}"/>
    <SolidColorBrush x:Key="OnStatusCompletedBrush" Color="{DynamicResource OnStatusCompletedColor}"/>
    <SolidColorBrush x:Key="StatusRepeatedBrush" Color="{DynamicResource StatusRepeatedColor}" />
    <SolidColorBrush x:Key="OnStatusRepeatedBrush" Color="{DynamicResource OnStatusRepeatedColor}" />
    <SolidColorBrush x:Key="StatusRejectedBrush" Color="{DynamicResource StatusRejectedColor}"/>
    <SolidColorBrush x:Key="OnStatusRejectedBrush" Color="{DynamicResource OnStatusRejectedColor}"/>
    
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#f1f5f9"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#94a3b8"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#334155"/>
    <SolidColorBrush x:Key="DestructiveRedBrush" Color="#dc2626"/>
    <SolidColorBrush x:Key="OnDestructiveRedBrush" Color="#ffffff"/>
</ResourceDictionary>


