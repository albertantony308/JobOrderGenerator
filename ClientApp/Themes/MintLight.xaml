<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mint Light Theme -->
    <Color x:Key="BackgroundColor">#f0fdf4</Color>
    <Color x:Key="SurfaceColor">#f0fdf4</Color>
    <Color x:Key="SurfaceContainerLowColor">#dcfce7</Color>
    <Color x:Key="SurfaceContainerColor">#bbf7d0</Color>
    <Color x:Key="SurfaceContainerHighColor">#f0fdf4</Color>
    <Color x:Key="SurfaceContainerHighestColor">#dcfce7</Color>
    <Color x:Key="SurfaceContainerLowestColor">#ffffff</Color>
    
    <Color x:Key="PrimaryColor">#15803d</Color>
    <Color x:Key="PrimaryContainerColor">#dcfce7</Color>
    <Color x:Key="OnPrimaryColor">#ffffff</Color>

    <Color x:Key="StatusPendingColor">#fef9c3</Color>
    <Color x:Key="OnStatusPendingColor">#854d0e</Color>
    <Color x:Key="StatusInProgressColor">#dbeafe</Color>
    <Color x:Key="OnStatusInProgressColor">#1e40af</Color>
    <Color x:Key="StatusCompletedColor">#dcfce7</Color>
    <Color x:Key="OnStatusCompletedColor">#166534</Color>
    <Color x:Key="StatusRepeatedColor">#f3e5f5</Color>
    <Color x:Key="OnStatusRepeatedColor">#7b1fa2</Color>
    <Color x:Key="StatusRejectedColor">#fef2f2</Color>
    <Color x:Key="OnStatusRejectedColor">#b91c1c</Color>
    
    <Color x:Key="OnSurfaceColor">#14532d</Color>
    <Color x:Key="OnSurfaceVariantColor">#166534</Color>
    <Color x:Key="OutlineColor">#cbd5e1</Color>
    <Color x:Key="TertiaryColor">#15803d</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#f0fdf4"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#f0fdf4"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#dcfce7"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#bbf7d0"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#f0fdf4"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#dcfce7"/>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#ffffff"/>
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="#15803d"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#dcfce7"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#14532d"/>

    <SolidColorBrush x:Key="TertiaryBrush" Color="#15803d"/>
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#dcfce7"/>
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#166534"/>

    <SolidColorBrush x:Key="StatusPendingBrush" Color="{DynamicResource StatusPendingColor}"/>
    <SolidColorBrush x:Key="OnStatusPendingBrush" Color="{DynamicResource OnStatusPendingColor}"/>
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="{DynamicResource StatusInProgressColor}"/>
    <SolidColorBrush x:Key="OnStatusInProgressBrush" Color="{DynamicResource OnStatusInProgressColor}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{DynamicResource StatusCompletedColor}"/>
    <SolidColorBrush x:Key="OnStatusCompletedBrush" Color="{DynamicResource OnStatusCompletedColor}"/>
    <SolidColorBrush x:Key="StatusRepeatedBrush" Color="{DynamicResource StatusRepeatedColor}" />
    <SolidColorBrush x:Key="OnStatusRepeatedBrush" Color="{DynamicResource OnStatusRepeatedColor}" />
    <SolidColorBrush x:Key="StatusRejectedBrush" Color="{DynamicResource StatusRejectedColor}"/>
    <SolidColorBrush x:Key="OnStatusRejectedBrush" Color="{DynamicResource OnStatusRejectedColor}"/>
    
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#14532d"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#166534"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#22c55e"/>
    <SolidColorBrush x:Key="DestructiveRedBrush" Color="#fee2e2"/>
    <SolidColorBrush x:Key="OnDestructiveRedBrush" Color="#ef4444"/>
</ResourceDictionary>


