<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pure Light Theme -->
    <Color x:Key="BackgroundColor">#f8f9fa</Color>
    <Color x:Key="SurfaceColor">#f8f9fa</Color>
    <Color x:Key="SurfaceContainerLowColor">#f0f2f5</Color>
    <Color x:Key="SurfaceContainerColor">#e1e3e8</Color>
    <Color x:Key="SurfaceContainerHighColor">#f1f3f4</Color>
    <Color x:Key="SurfaceContainerHighestColor">#e8eaed</Color>
    <Color x:Key="SurfaceContainerLowestColor">#ffffff</Color>
    
    <Color x:Key="PrimaryColor">#0067c0</Color>
    <Color x:Key="PrimaryContainerColor">#d3e4ff</Color>
    <Color x:Key="OnPrimaryColor">#ffffff</Color>

    <Color x:Key="StatusPendingColor">#fff9c4</Color>
    <Color x:Key="OnStatusPendingColor">#f57f17</Color>
    <Color x:Key="StatusInProgressColor">#e3f2fd</Color>
    <Color x:Key="OnStatusInProgressColor">#1976d2</Color>
    <Color x:Key="StatusCompletedColor">#e8f5e9</Color>
    <Color x:Key="OnStatusCompletedColor">#388e3c</Color>
    <Color x:Key="StatusRepeatedColor">#f3e5f5</Color>
    <Color x:Key="OnStatusRepeatedColor">#7b1fa2</Color>
    <Color x:Key="StatusRejectedColor">#ffebee</Color>
    <Color x:Key="OnStatusRejectedColor">#c62828</Color>
    
    <Color x:Key="OnSurfaceColor">#191c1e</Color>
    <Color x:Key="OnSurfaceVariantColor">#41484d</Color>
    <Color x:Key="OutlineColor">#747775</Color>
    <Color x:Key="TertiaryColor">#0067c0</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#f8f9fa"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#f8f9fa"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#f0f2f5"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#e1e3e8"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#f1f3f4"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#e8eaed"/>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#ffffff"/>
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0067c0"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#d3e4ff"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#001c38"/>

    <SolidColorBrush x:Key="TertiaryBrush" Color="#0067c0"/>
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#d3e4ff"/>
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#5f6368"/>

    <SolidColorBrush x:Key="StatusPendingBrush" Color="{DynamicResource StatusPendingColor}"/>
    <SolidColorBrush x:Key="OnStatusPendingBrush" Color="{DynamicResource OnStatusPendingColor}"/>
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="{DynamicResource StatusInProgressColor}"/>
    <SolidColorBrush x:Key="OnStatusInProgressBrush" Color="{DynamicResource OnStatusInProgressColor}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{DynamicResource StatusCompletedColor}"/>
    <SolidColorBrush x:Key="OnStatusCompletedBrush" Color="{DynamicResource OnStatusCompletedColor}"/>
    <SolidColorBrush x:Key="StatusRepeatedBrush" Color="{DynamicResource StatusRepeatedColor}"/>
    <SolidColorBrush x:Key="OnStatusRepeatedBrush" Color="{DynamicResource OnStatusRepeatedColor}"/>
    <SolidColorBrush x:Key="StatusRejectedBrush" Color="{DynamicResource StatusRejectedColor}"/>
    <SolidColorBrush x:Key="OnStatusRejectedBrush" Color="{DynamicResource OnStatusRejectedColor}"/>
    
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#191c1e"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#41484d"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#71787d"/>
    <SolidColorBrush x:Key="DestructiveRedBrush" Color="#fee2e2"/>
    <SolidColorBrush x:Key="OnDestructiveRedBrush" Color="#ef4444"/>
</ResourceDictionary>

