<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Solarized Light Theme -->
    <Color x:Key="BackgroundColor">#fdf6e3</Color>
    <Color x:Key="SurfaceColor">#fdf6e3</Color>
    <Color x:Key="SurfaceContainerLowColor">#eee8d5</Color>
    <Color x:Key="SurfaceContainerColor">#eee8d5</Color>
    <Color x:Key="SurfaceContainerHighColor">#fdf6e3</Color>
    <Color x:Key="SurfaceContainerHighestColor">#eee8d5</Color>
    <Color x:Key="SurfaceContainerLowestColor">#ffffff</Color>
    
    <Color x:Key="PrimaryColor">#b58900</Color>
    <Color x:Key="PrimaryContainerColor">#eee8d5</Color>
    <Color x:Key="OnPrimaryColor">#002b36</Color>

    <Color x:Key="StatusPendingColor">#fff3cd</Color>
    <Color x:Key="OnStatusPendingColor">#856404</Color>
    <Color x:Key="StatusInProgressColor">#cce5ff</Color>
    <Color x:Key="OnStatusInProgressColor">#004085</Color>
    <Color x:Key="StatusCompletedColor">#d4edda</Color>
    <Color x:Key="OnStatusCompletedColor">#155724</Color>
    <Color x:Key="StatusRepeatedColor">#f3e5f5</Color>
    <Color x:Key="OnStatusRepeatedColor">#7b1fa2</Color>
    <Color x:Key="StatusRejectedColor">#fbebeb</Color>
    <Color x:Key="OnStatusRejectedColor">#dc322f</Color>
    
    <Color x:Key="OnSurfaceColor">#002b36</Color>
    <Color x:Key="OnSurfaceVariantColor">#073642</Color>
    <Color x:Key="OutlineColor">#93a1a1</Color>
    <Color x:Key="TertiaryColor">#cb4b16</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#fdf6e3"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#fdf6e3"/>
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="#eee8d5"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#eee8d5"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#fdf6e3"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#eee8d5"/>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#ffffff"/>
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="#b58900"/>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#eee8d5"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#002b36"/>
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#002b36"/>
    
    <SolidColorBrush x:Key="TertiaryBrush" Color="#cb4b16"/> <!-- Solarized Orange -->
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#fbe9e7"/>
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#93a1a1"/>

    <SolidColorBrush x:Key="StatusPendingBrush" Color="{DynamicResource StatusPendingColor}"/>
    <SolidColorBrush x:Key="OnStatusPendingBrush" Color="{DynamicResource OnStatusPendingColor}"/>
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="{DynamicResource StatusInProgressColor}"/>
    <SolidColorBrush x:Key="OnStatusInProgressBrush" Color="{DynamicResource OnStatusInProgressColor}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{DynamicResource StatusCompletedColor}"/>
    <SolidColorBrush x:Key="OnStatusCompletedBrush" Color="{DynamicResource OnStatusCompletedColor}"/>
    <SolidColorBrush x:Key="StatusRepeatedBrush" Color="{DynamicResource StatusRepeatedColor}" />
    <SolidColorBrush x:Key="OnStatusRepeatedBrush" Color="{DynamicResource OnStatusRepeatedColor}" />
    <SolidColorBrush x:Key="StatusRejectedBrush" Color="{DynamicResource StatusRejectedColor}"/>
    <SolidColorBrush x:Key="OnStatusRejectedBrush" Color="{DynamicResource OnStatusRejectedColor}"/>
    
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="#002b36"/>
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#657b83"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="#93a1a1"/>
    <SolidColorBrush x:Key="DestructiveRedBrush" Color="#fee2e2"/>
    <SolidColorBrush x:Key="OnDestructiveRedBrush" Color="#ef4444"/>
</ResourceDictionary>


